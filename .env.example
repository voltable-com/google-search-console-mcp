# Environment variables the server reads. Nothing loads this file; export
# them in your shell, systemd unit, or Cursor mcp.json env block.

# Desktop (installed) OAuth client JSON from Google Cloud Console with the
# Search Console API enabled. See client.example.json for the shape.
GSC_OAUTH_CLIENT_FILE=/path/to/client.json

# Optional. Defaults to ~/.local/share/gsc-mcp/token.json, written mode 0600.
# GSC_TOKEN_FILE=

# serve-http only. Port on 127.0.0.1; default 8097.
# GSC_HTTP_PORT=8097

# serve-http only. Comma-separated hostnames the Host/Origin guard accepts
# beyond loopback, usually the name your reverse proxy forwards.
# GSC_ALLOWED_HOSTS=your-host.example

# serve-http only. Public URL of this server's login page, used for the
# browser paste-back login. Unset means the login routes answer 503.
# GSC_LOGIN_URL=https://your-host.example/mcp/gsc/login/
