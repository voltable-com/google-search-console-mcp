[Unit]
Description=GSC MCP server (Search Console read-only, streamable HTTP)
After=network.target

[Service]
Type=simple
User=toni
WorkingDirectory=/srv/gsc-mcp
Environment=GSC_OAUTH_CLIENT_FILE=/home/toni/.config/gsc-mcp/client.json
Environment=GSC_HTTP_PORT=8097
ExecStart=/usr/bin/node /srv/gsc-mcp/dist/main.js serve-http
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
